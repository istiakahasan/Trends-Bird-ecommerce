// This im Prisma schema 


// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 1. Authentication (Handled stateless in JWT/Controllers)

// 2. Permission
model PermissionGroup {
  id          Int          @id @default(autoincrement())
  name        String       @unique // e.g. "product"
  description String?
  permissions Permission[]
}

model Permission {
  id          Int             @id @default(autoincrement())
  name        String          @unique // e.g. "product:create"
  description String?
  groupId     Int
  group       PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles       Role[]
}

// 3. Role
model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

// 4. User
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String?
  phone        String?
  gender       String?
  avatar       String?
  active       Boolean  @default(true)
  refreshToken String?
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  mediaUploads Media[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 5. Media
model Media {
  id           Int       @id @default(autoincrement())
  fileName     String                        // original client filename
  storedName   String    @unique             // UUID-based name on disk
  path         String                        // absolute disk path
  url          String                        // public URL served by static middleware
  thumbnailUrl String?                       // public URL of the 300x300 WebP thumbnail
  mimeType     String                        // e.g. image/jpeg — validated from magic bytes
  type         String                        // "image" | "video" | "document"
  size         Int                           // bytes
  width        Int?                          // image dimensions only
  height       Int?                          // image dimensions only
  altText      String?
  title        String?
  uploadedById Int
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 6. Category
model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
}

// 7. Brand
model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  logo        String?
  status      Boolean   @default(true)
  products    Product[]
}

// 8. Attribute
model Attribute {
  id     Int              @id @default(autoincrement())
  name   String           @unique
  slug   String           @unique
  type   String           // e.g. "dropdown", "radio", "checkbox", "color", "image"
  values AttributeValue[]
}

model AttributeValue {
  id          Int              @id @default(autoincrement())
  value       String
  slug        String
  reference   String?          // e.g. hex code or media URL
  attributeId Int
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]

  @@unique([attributeId, slug])
}

// 9. Product
model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  brandId     Int?
  brand       Brand?    @relation(fields: [brandId], references: [id])
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  media       Media[]
  variants    ProductVariant[]
}

model ProductVariant {
  id         Int              @id @default(autoincrement())
  productId  Int
  product    Product          @relation(fields: [productId], references: [id])
  sku        String           @unique
  price      Float
  stock      Int              @default(0)
  attributes AttributeValue[]
}
